    "Allow FancyTool to record your screen in System Settings, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube FancyTool in den Systemeinstellungen die Bildschirmaufnahme und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FancyTool to record your screen in System Settings, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez FancyTool à enregistrer votre écran dans Réglages Système, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定でFancyToolに画面収録を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 FancyTool의 화면 기록을 허용한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置中允许 FancyTool 录制屏幕，然后重试。"
          }
        }
      }
    },
