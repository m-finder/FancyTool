    "Allow Access to System Panels" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf Systemfenster erlauben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Access to System Panels"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’accès aux panneaux système"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムパネルへのアクセスを許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 패널 접근 허용"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许打开系统原生面板"
          }
        }
      }
    },
    "Allow Bluetooth access in System Settings to manage paired devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Bluetooth in den Systemeinstellungen, um gekoppelte Geräte zu verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Bluetooth access in System Settings to manage paired devices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le Bluetooth dans Réglages Système pour gérer les appareils jumelés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリング済みデバイスを管理するには、システム設定でBluetoothへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링된 기기를 관리하려면 시스템 설정에서 Bluetooth 접근을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置中允许蓝牙访问，以管理已配对设备。"
          }
        }
      }
    },
    "Allow Bluetooth access to show paired devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Bluetooth, um gekoppelte Geräte anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Bluetooth access to show paired devices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le Bluetooth pour afficher les appareils jumelés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリング済みデバイスを表示するにはBluetoothへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링된 기기를 표시하려면 Bluetooth 접근을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许蓝牙访问后，即可显示已配对设备。"
          }
        }
      }
    },
    "Allow FancyTool in System Settings → Privacy & Security → Screen Recording, then restart FancyTool before taking a screenshot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube FancyTool unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme. Starte FancyTool anschließend neu, bevor du einen Screenshot erstellst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FancyTool in System Settings → Privacy & Security → Screen Recording, then restart FancyTool before taking a screenshot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez FancyTool dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran, puis redémarrez FancyTool avant de prendre une capture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 → プライバシーとセキュリティ → 画面収録でFancyToolを許可し、FancyToolを再起動してから撮影してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 화면 기록에서 FancyTool을 허용한 다음, FancyTool을 재시작하고 스크린샷을 촬영하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 隐私与安全性 → 屏幕录制”中允许 FancyTool，然后重新启动 FancyTool 再截图。"
          }
        }
      }
    },
    "Allow FancyTool in System Settings > Privacy & Security > Accessibility to open the original macOS menu-bar panels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube FancyTool unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen, um die macOS-Menüleistenfenster zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FancyTool in System Settings > Privacy & Security > Accessibility to open the original macOS menu-bar panels."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez FancyTool dans Réglages Système > Confidentialité et sécurité > Accessibilité pour ouvrir les panneaux macOS de la barre des menus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのメニューバーパネルを開くには、システム設定 > プライバシーとセキュリティ > アクセシビリティでFancyToolを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 메뉴 막대 패널을 열려면 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 FancyTool을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 隐私与安全性 → 辅助功能”中允许 FancyTool，以打开 macOS 原生菜单栏面板。"
          }
        }
      }
    },
