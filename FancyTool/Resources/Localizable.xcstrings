          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペースト"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 붙여넣기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动粘贴"
          }
        }
      }
    },
    "Auto Paste requires Accessibility permission. Enable it in System Settings > Privacy & Security > Accessibility, then toggle Auto Paste again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisches Einfügen benötigt die Bedienungshilfen-Berechtigung. Aktiviere sie unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen und schalte dann Automatisches Einfügen erneut ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Paste requires Accessibility permission. Enable it in System Settings > Privacy & Security > Accessibility, then toggle Auto Paste again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage automatique nécessite l'autorisation d'accessibilité. Activez-la dans Réglages système > Confidentialité et sécurité > Accessibilité, puis réactivez le collage automatique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペーストにはアクセシビリティ権限が必要です。システム設定 > プライバシーとセキュリティ > アクセシビリティで有効にしてから、再度自動ペーストをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 붙여넣기에는 접근성 권한이 필요합니다. 시스템 설정 > 개인정보 및 보안 > 접근성에서 활성화한 후 자동 붙여넣기를 다시 켜주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动粘贴需要辅助功能权限。请在系统设置 > 隐私与安全性 > 辅助功能中启用,然后再次打开自动粘贴。"
          }
        }
      }
    },
