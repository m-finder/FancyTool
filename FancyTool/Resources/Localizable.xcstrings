    "Allow FancyTool in System Settings → Privacy & Security → Screen Recording, then restart FancyTool before taking a screenshot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube FancyTool unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme. Starte FancyTool anschließend neu, bevor du einen Screenshot erstellst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FancyTool in System Settings → Privacy & Security → Screen Recording, then restart FancyTool before taking a screenshot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez FancyTool dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran, puis redémarrez FancyTool avant de prendre une capture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 → プライバシーとセキュリティ → 画面収録でFancyToolを許可し、FancyToolを再起動してから撮影してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 화면 기록에서 FancyTool을 허용한 다음, FancyTool을 재시작하고 스크린샷을 촬영하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 隐私与安全性 → 屏幕录制”中允许 FancyTool，然后重新启动 FancyTool 再截图。"
          }
        }
      }
    },
    "Allow FancyTool to record your screen in System Settings, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube FancyTool in den Systemeinstellungen die Bildschirmaufnahme und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FancyTool to record your screen in System Settings, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez FancyTool à enregistrer votre écran dans Réglages Système, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定でFancyToolに画面収録を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 FancyTool의 화면 기록을 허용한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置中允许 FancyTool 录制屏幕，然后重试。"
          }
        }
      }
    },
