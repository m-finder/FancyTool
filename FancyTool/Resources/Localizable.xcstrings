            "state" : "translated",
            "value" : "Collage automatique"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペースト"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
