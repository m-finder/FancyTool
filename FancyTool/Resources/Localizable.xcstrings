    "A little dog that rests, plays and keeps you company." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleiner Hund, der ruht, spielt und dir Gesellschaft leistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little dog that rests, plays and keeps you company."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit chien qui se repose, joue et vous tient compagnie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休んだり遊んだりしながら、そばにいてくれる小さな犬。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉬고 놀며 곁을 지켜 주는 작은 강아지."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陪你休息、玩耍的小狗。"
          }
        }
      }
    },
